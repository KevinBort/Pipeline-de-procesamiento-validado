# Copia este archivo a ".env" y completa los valores. NUNCA subas el .env a Git.

LLM_PROVIDER=openai          # openai | anthropic
LLM_MODEL=                   # nombre del modelo, según la documentación del proveedor

OPENAI_API_KEY=              # solo si LLM_PROVIDER=openai
ANTHROPIC_API_KEY=           # solo si LLM_PROVIDER=anthropic
